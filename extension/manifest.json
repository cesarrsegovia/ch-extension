{
    "manifest_version": 3,
    "name": "FL-Sports",
    "version": "1.0.0",
    "description": "Real-time sports dashboard — scores, standings, and fixtures for soccer, NBA, NHL, and MLB.",
    "icons": {
        "16": "logo-fl.png",
        "48": "logo-fl.png",
        "128": "logo-fl.png"
    },
    "action": {
        "default_popup": "index.html",
        "default_icon": {
            "16": "logo-fl.png",
            "48": "logo-fl.png",
            "128": "logo-fl.png"
        }
    },
    "side_panel": {
        "default_path": "index.html"
    },
    "background": {
        "service_worker": "src/background/index.ts",
        "type": "module"
    },
    "permissions": [
        "storage",
        "alarms",
        "sidePanel"
    ],
    "host_permissions": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
    ]
}